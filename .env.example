# Optional configuration — copy to .env and adjust as needed

# Database (defaults to testing_system.db next to the app)
# DATABASE_URL=sqlite:///testing_system.db

# Open Trivia DB endpoints (no API key required)
# OPENTDB_BASE_URL=https://opentdb.com/api.php
# OPENTDB_CATEGORY_URL=https://opentdb.com/api_category.php
# API_TIMEOUT=15
# USE_FALLBACK_ON_ERROR=true

# Application defaults
# DEFAULT_QUESTIONS=10
# DEFAULT_DURATION_MINUTES=15
# DEFAULT_THEME=dark
# DEFAULT_LANGUAGE=en
# DEFAULT_SOUND=true
